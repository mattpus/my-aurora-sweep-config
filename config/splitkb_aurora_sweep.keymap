#include <dt-bindings/zmk/mouse.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

&mt {
    flavor = "balanced";
    quick-tap-ms = <190>;//for double tap backspace to repeat
    tapping-term-ms = <280>;
    require-prior-idle-ms = <120>;//higher value makes hold harder to trigger, cause it forces a tap instead if within this time. if correct with backspace, we may want a shift/mod so we set this to lowish
};

/ {
    combos {
        compatible = "zmk,combos";

        caps_word {
            bindings = <&caps_word>;
            key-positions = <6 7>;
            layers = <0>;
        };

        esc {
            bindings = <&kp ESCAPE>;
            key-positions = <16 17>;
            layers = <0>;
        };

        del {
            bindings = <&kp DEL>;
            key-positions = <26 27>;
            layers = <0>;
        };

        cmd_v {
            bindings = <&kp LG(V)>;
            key-positions = <13 23>;
            layers = <0>;
        };

        esc2 {
            bindings = <&kp ESC>;
            key-positions = <0 1>;
            layers = <0>;
        };
    };

    macros {
        dot_shift: dot_shift {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp DOT &kp SPACE &sk LEFT_SHIFT>;
            label = "DOT_SHIFT";
        };
    };

    behaviors {
        no_idle: no_idle {
            compatible = "zmk,behavior-hold-tap";
            label = "NO_IDLE";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <150>;
            require-prior-idle-ms = <(-1)>;
            flavor = "balanced";
        };

        dotques: dotques {
            compatible = "zmk,behavior-mod-morph";
            label = "DOTQUES";
            bindings = <&kp PERIOD>, <&kp QUESTION>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT)>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&kp Q                  &kp W            &kp F       &kp P    &kp B    &kp J  &kp L    &kp U       &kp Y        &kp SEMICOLON
&no_idle LEFT_SHIFT A  &mt LEFT_ALT R   &mt LGUI S  &lt 5 T  &kp G    &kp M  &lt 6 N  &mt RGUI E  &mt RALT I   &mt RIGHT_SHIFT O
&mt LCTRL Z            &kp X            &kp C       &kp D    &kp V    &kp K  &kp H    &kp COMMA   &kp PERIOD   &kp SLASH
&lt 1 ENTER            &lt 3 BACKSPACE                                                            &lt 3 SPACE  &lt 4 RSHIFT
            >;
        };

        numbers {
            bindings = <
&kp MINUS       &kp NUMBER_7  &kp NUMBER_8  &kp NUMBER_9  &kp AMPS         &kp PLUS   &kp N7  &kp N8  &kp N9           &kp ASTERISK
&kp NUMBER_0    &kp NUMBER_4  &kp NUMBER_5  &kp NUMBER_6  &kp PIPE         &kp MINUS  &kp N4  &kp N5  &kp N6           &mt COMMA PERIOD
&kp C_SNAPSHOT  &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp BACKSLASH    &kp EQUAL  &kp N1  &kp N2  &kp N3           &kp SLASH
&to 0           &trans                                                                                &mt ENTER SPACE  &kp BACKSPACE
            >;
        };

        symbols {
            bindings = <
&kp GRAVE            &kp TILDE         &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp AMPS         &kp PLUS   &none       &none        &none         &kp ASTERISK
&mt LSHFT LESS_THAN  &kp GREATER_THAN  &kp LEFT_BRACKET      &kp RIGHT_BRACKET      &kp PIPE         &kp MINUS  &kp DOLLAR  &kp PERCENT  &kp CARET     &mt COMMA PERIOD
&none                &kp UNDERSCORE    &kp LEFT_BRACE        &kp RIGHT_BRACE        &kp BACKSLASH    &kp EQUAL  &kp EXCL    &kp AT       &kp HASH      &kp SLASH
&to 0                &trans                                                                                                              &mt ENTER N0  &kp BACKSPACE
            >;
        };

        nav {
            bindings = <
&kp LS(LC(LA(LG(Q))))  &kp LS(LA(LG(LC(W))))  &kp LS(LA(LC(LG(F))))  &kp LS(LA(LG(LC(P))))  &kp LS(LA(LC(LG(B))))    &kp LS(LA(LC(LG(J))))  &kp LS(LA(LC(LG(L))))  &kp LS(LA(LC(LG(U))))  &kp LS(LA(LC(LG(Y))))  &kp LS(LA(LC(LG(SEMICOLON))))
&kp LS(LA(LC(LG(A))))  &kp LS(LC(LA(LG(R))))  &kp LS(LA(LC(LG(S))))  &kp LS(LA(LC(LG(T))))  &kp LS(LA(LC(LG(G))))    &kp LS(LA(LC(LG(M))))  &kp LEFT               &kp DOWN               &kp UP_ARROW           &kp RIGHT
&kp LS(LA(LC(LG(Z))))  &kp LS(LA(LC(LG(X))))  &kp LS(LA(LC(LG(C))))  &kp LS(LC(LA(LG(D))))  &kp LS(LA(LC(LG(V))))    &kp LS(LA(LC(LG(K))))  &kp LS(LC(LA(LG(H))))  &kp LS(LA(LC(LG(E))))  &kp LS(LA(LC(LG(I))))  &kp LS(LA(LC(LG(O))))
&none                  &none                                                                                                                                                              &trans                 &none
            >;
        };

        sys {
            bindings = <
&sys_reset  &bt BT_CLR_ALL  &none           &none  &tog 1    &kp C_VOLUME_UP    &kp C_NEXT        &none  &none   &kp INSERT
&none       &bt BT_NXT      &none           &none  &to 5     &kp C_VOLUME_DOWN  &kp C_PREV        &none  &none   &none
&none       &kp KP_NUMLOCK  &kp SCROLLLOCK  &none  &none     &kp C_MUTE         &kp C_PLAY_PAUSE  &none  &none   &kp PRINTSCREEN
&none       &trans                                                                                       &trans  &none
            >;
        };

        game {
            bindings = <
&kp ESC    &kp Q      &kp W  &kp E  &kp R    &kp T  &kp Y  &kp U  &kp I      &kp O
&kp LSHFT  &kp A      &kp S  &kp D  &kp F    &kp G  &kp H  &kp J  &kp K      &kp L
&kp LCTRL  &kp Z      &kp X  &kp C  &kp V    &kp B  &kp N  &kp M  &kp COMMA  &to 0
&kp TAB    &kp SPACE                                              &kp ENTER  &kp LALT
            >;
        };

        layer_6 {
            bindings = <
&trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans
&trans  &trans                                                    &trans  &trans
            >;
        };
    };
};
